# String utilities module


##
# Converts any value to its string representation.
intrinsic func to_string(value: any): string

##
# Returns the length of a string.
intrinsic func len(s: string): num

##
# Converts a num to its string representation.
intrinsic func from_num(n: num): string

##
# Returns true if the string contains the specified substring.
intrinsic func contains(s: string, sub: string): bool

##
# Returns true if the string starts with the specified substring.
intrinsic func starts_with(s: string, sub: string): bool

##
# Returns true if the string ends with the specified substring.
intrinsic func ends_with(s: string, sub: string): bool

# List utilities module

##
# Returns the num of elements in a list.
intrinsic func len(l: any[]): num

##
# Adds an element to the end of a list.
intrinsic func push(l: any[], value: any)

##
# Removes and returns the last element from a list.
intrinsic func pop(l: any[]): any

##
# Returns the element at the specified index.
intrinsic func get(l: any[], index: num): any

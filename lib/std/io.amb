/// Standard Input/Output Module
///
/// Provides core primitives for interacting with standard input, standard output, and terminal streams.
/// @module core:io

/// Prints the string representation of a value to standard output without a trailing newline.
///
/// @param value The value to write to standard output.
intrinsic func print(value: any)

/// Prints the string representation of a value to standard output, followed by a line break.
///
/// @param value The value to write to standard output.
intrinsic func println(value: any)

/// Reads a single line of text from standard input up to the next newline sequence.
///
/// @return The text read from standard input excluding the trailing newline, or an empty string at EOF.
intrinsic func readln(): string